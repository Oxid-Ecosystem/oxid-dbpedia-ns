# Copy to .env (gitignored) or export in the shell. Never commit a real key.
OPENAI_API_KEY=sk-...
# OxidDB instance used by loader/oxiddb_load.py
OXIDDB_URL=http://localhost:7878
OXIDDB_API_KEY=

# Publishing targets (publish/to_huggingface.py, publish/to_kaggle.py)
# HF_DATASET_REPO=<hf-owner>/oxid-dbpedia-ns
# HF_TOKEN=            # or run `hf auth login` once
# KAGGLE_DATASET_ID=<your-kaggle-username>/oxid-dbpedia-ns
# Kaggle credentials come from `kaggle auth login`, KAGGLE_API_TOKEN or ~/.kaggle/access_token.
