# Copy to deploy/.env (gitignored). Never commit a real token.
# Generate one with:  python3 -c "import secrets;print(secrets.token_urlsafe(24))"
OXD_API_TOKEN=
# Prebuilt demo image: dataset already inside, no bundle to ship.
# NOTE: no hyphen inside the suffix. Oxid-Cloud's provision dropdown filters on
# ^v?\d+\.\d+(\.\d+)?(-[0-9A-Za-z.]+)?$ — a second hyphen hides the tag.
OXD_IMAGE=rg.nl-ams.scw.cloud/oxid-db/oxid-db:0.9.9-t50demo
# Empty engine instead, to restore a bundle into yourself:
# OXD_IMAGE=moonlightarray/oxid-db:0.9.9
# Host ports, if the defaults are taken.
# OXD_PORT=7878
# OXD_UI_PORT=7880
